#!/usr/bin/env python3
"""알림전화 AGI — 한국어 표현과 예약 로직을 여기 한 곳에만 둡니다.

    AGI(wakeup.agi,peek-time,HHMM,,${CALLERID(num)})       시각 해석만
    AGI(wakeup.agi,book-time,HHMM,,${CALLERID(num)})       시각 알림 예약
    AGI(wakeup.agi,peek-after,MMM,,${CALLERID(num)})       N분 뒤 해석만
    AGI(wakeup.agi,book-after,MMM,,${CALLERID(num)})       N분 뒤 예약
    AGI(wakeup.agi,peek-rep,DAYS,HHMM,${CALLERID(num)})    반복 해석만
    AGI(wakeup.agi,book-rep,DAYS,HHMM,${CALLERID(num)})    반복 등록
    AGI(wakeup.agi,list,,${UNIQUEID},${CALLERID(num)})     목록 읽어 주기
    AGI(wakeup.agi,del,N,${UNIQUEID},${CALLERID(num)})     N번 삭제 (0 이면 전부)
    AGI(wakeup.agi,undo,KEY,,${CALLERID(num)})             방금 만든 예약 취소
    AGI(wakeup.agi,prune,,,0)                              지난 call file 청소

DAYS  "0"=평일(월~금)  "8"=주말(토일)  "9"=매일  그 외는 1=월 … 7=일 을 이어서
      0/8/9 는 단독으로만 씁니다. "01" 같은 건 오입력으로 봅니다.

돌려주는 채널 변수
    WK_OK       1 성공 / 0 실패          (호출 전에 다이얼플랜이 0 으로 리셋합니다)
    WK_ERR      실패 종류: input | full | io | dup | gone
    WK_CONFIRM  확정 안내 재생 목록
    WK_DISPLAY  전화기 화면용 짧은 글
    WK_TEXT     로그용 문장
    WK_COUNT    목록 개수 (list)
    WK_ITEM     목록 한 건의 재생 목록    WK_KIND  once | rep   (item)
    WK_KEY      방금 만든/고른 예약의 키 (undo 로 넘깁니다)
"""
from __future__ import annotations

import fcntl
import json
import os
import sys
from datetime import datetime, timedelta
from pathlib import Path

BANK = "custom/bank"
SOUNDS_DIR = Path(os.getenv("WK_SOUNDS", "/var/lib/asterisk/sounds/custom/bank"))
SPOOL = Path(os.getenv("WK_SPOOL", "/var/spool/asterisk/outgoing"))
STAGING = Path(os.getenv("WK_STAGING", "/var/spool/asterisk/tmp"))
STATE = Path(os.getenv("WK_STATE", "/var/lib/asterisk/wakeup"))
RULES = STATE / "rules.json"
LOG = Path(os.getenv("WK_LOG", "/var/log/asterisk/wakeup.log"))
DEST_CTX = os.getenv("WK_DEST_CTX", "wakeup-call")

# 콜백 방식: 7000 을 걸면 끊고, 시스템이 그 내선으로 되걸어 '수신'으로 메뉴를
# 진행합니다. 발신 통화는 화면 갱신이 잘 안 되는 기종이 있어(내가 발신자),
# 수신으로 바꾸면 화면이 제대로 뜹니다.
CB_MENU_CTX = os.getenv("WK_CB_MENU_CTX", "wakeup-menu")   # 콜백이 답하면 실행할 메뉴
CB_DIAL_CTX = os.getenv("WK_CB_DIAL_CTX", "wakeup-cb-dial")  # 자동응답 헤더 붙여 발신
CB_DELAY = int(os.getenv("WK_CB_DELAY", "1"))      # 끊고 1초 뒤 되건다 (0초는 너무 급함)
CB_RETRY_DELAY = int(os.getenv("WK_CB_RETRY_DELAY", "60"))  # 무입력이면 1분 뒤 한 번 더

RING_SEC = int(os.getenv("WK_RING_SEC", "60"))      # 한 번에 1분 울림
MAX_RETRY = int(os.getenv("WK_MAX_RETRY", "2"))     # 안 받으면 2번 더 (합쳐서 3번)
RETRY_SEC = int(os.getenv("WK_RETRY_SEC", "30"))    # 벨 끝나고 30초 뒤 재시도

# 목록 번호가 한 자리라 아홉 개까지만 전화로 다룰 수 있습니다.
# 그래서 예약 상한도 아홉으로 맞춥니다. 안 그러면 열 번째부터 전화로 못 지웁니다.
MAX_BOOK = int(os.getenv("WK_MAX_BOOK", "9"))
# 남은 시간("삼십 분 후에 알람이 울립니다")을 말할지 말지.
# 기본은 끕니다. 시각을 이미 들려주고 나서 남은 시간까지 또 말하면
# 안내가 길어지고, 정작 중요한 "몇 시"가 묻힙니다.
# 다시 켜려면 /etc/asterisk 쪽에서 WK_SAY_UNTIL=1 을 주세요.
SAY_UNTIL = os.getenv("WK_SAY_UNTIL", "0") not in ("0", "no", "false", "")
# 켰을 때 말해 주는 상한. 이보다 멀면 "오늘/내일" 로만 알려줍니다.
SAY_UNTIL_MAX_MIN = int(os.getenv("WK_SAY_UNTIL_MAX_MIN", "240"))
# 부팅 때 이만큼 지난 call file 은 버립니다 (안 그러면 밀린 알람이 한꺼번에 울립니다)
STALE_SEC = int(os.getenv("WK_STALE_SEC", "300"))

HOUR_WORD = {1: "한", 2: "두", 3: "세", 4: "네", 5: "다섯", 6: "여섯",
             7: "일곱", 8: "여덟", 9: "아홉", 10: "열", 11: "열한", 12: "열두"}
DUR_HOUR = {1: "한", 2: "두", 3: "세", 4: "네", 5: "다섯", 6: "여섯", 7: "일곱",
            8: "여덟", 9: "아홉", 10: "열", 11: "열한", 12: "열두", 13: "열세",
            14: "열네", 15: "열다섯", 16: "열여섯", 17: "열일곱", 18: "열여덟",
            19: "열아홉", 20: "스무", 21: "스물한", 22: "스물두", 23: "스물세"}
ONES = ["", "일", "이", "삼", "사", "오", "육", "칠", "팔", "구"]
SIL = "sil-250"        # 절 사이에 끼우는 0.25초 무음
PERIOD_TEXT = {"p-dawn": "새벽", "p-am": "오전", "p-pm": "오후", "p-eve": "저녁",
               "p-night": "밤", "p-noon": "정오", "p-mid": "자정"}
DAY_TEXT = {1: "월요일", 2: "화요일", 3: "수요일", 4: "목요일",
            5: "금요일", 6: "토요일", 7: "일요일"}
DAY_SHORT = {1: "월", 2: "화", 3: "수", 4: "목", 5: "금", 6: "토", 7: "일"}


# ------------------------------------------------------------------ 한국어
def sino(n: int) -> str:
    t, o = divmod(n, 10)
    s = ("십" if t == 1 else ONES[t] + "십") if t else ""
    return (s + ONES[o]) if o else (s or "영")


def period_of(hh: int, mm: int) -> str:
    """'오전 열두시'는 한국어가 아닙니다. 시간대를 나누고 자정/정오는 따로."""
    if hh == 0 and mm == 0:
        return "p-mid"
    if hh == 12 and mm == 0:
        return "p-noon"
    if hh == 0:
        return "p-night"
    if 1 <= hh <= 5:
        return "p-dawn"
    if 6 <= hh <= 11:
        return "p-am"
    if 12 <= hh <= 17:
        return "p-pm"
    if 18 <= hh <= 20:
        return "p-eve"
    return "p-night"


def time_pieces(hh: int, mm: int, with_day: bool = False) -> list[str]:
    """with_day 는 앞에 오늘/내일/요일 이 붙는 경우입니다.

    '내일 자정' 은 한국어로 '내일 밤' 으로 읽힙니다. 코드가 뜻하는 것은
    내일 0시(=오늘 밤)라 24시간이 어긋납니다. 알람 시계에서 치명적입니다.
    그래서 날짜말이 붙을 때는 '새벽 열두시' 로 바꿔 말합니다.
    ('정오' 는 '내일 정오' 로 써도 뜻이 흔들리지 않아 그대로 둡니다.)
    """
    per = period_of(hh, mm)
    if per == "p-mid":
        return ["p-dawn", "h-12", "m-0"] if with_day else ["p-mid"]
    if per == "p-noon":
        return [per]
    # 0시대는 '밤 열두시'인데 '내일 밤 열두시 삼십분' 은 내일 밤으로 읽힙니다.
    # 날짜말이 붙을 때만 '새벽' 으로 바꿔 24시간 어긋남을 막습니다.
    if hh == 0 and with_day:
        per = "p-dawn"
    # 시각의 30분은 '반'. ('삼십 분 후에' 같은 소요시간에는 m-30 을 그대로 씁니다)
    mp = "m-half" if mm == 30 else f"m-{mm}"
    return [per, f"h-{hh % 12 or 12}", mp]


def time_text(hh: int, mm: int, with_day: bool = False) -> str:
    per = period_of(hh, mm)
    if per == "p-mid":
        return "새벽 열두 시 정각" if with_day else "자정"
    if per == "p-noon":
        return PERIOD_TEXT[per]
    if hh == 0 and with_day:
        per = "p-dawn"
    tail = "정각" if mm == 0 else ("반" if mm == 30 else sino(mm) + " 분")
    return f"{PERIOD_TEXT[per]} {HOUR_WORD[hh % 12 or 12]} 시 {tail}"


def rel_pieces(minutes: int) -> list[str]:
    """1번(몇 분 후)에서 들려줄 상대시각. "십 분 뒤", "한 시간 삼십 분 뒤"."""
    h, m = divmod(max(1, minutes), 60)
    out = []
    if h and h in DUR_HOUR:
        out.append(f"d-{h}")
    if m or not out:
        out.append(f"m-{m or 1}")
    return out + ["g-later"]


def rel_text(minutes: int) -> str:
    h, m = divmod(max(1, minutes), 60)
    parts = ([f"{DUR_HOUR[h]} 시간"] if h and h in DUR_HOUR else []) \
        + ([f"{sino(m)} 분"] if (m or not h) else [])
    return " ".join(parts) + " 뒤"


def until_pieces(minutes: int) -> list[str]:
    if not SAY_UNTIL:
        return []
    if minutes < 1:
        return ["g-soon"]
    if minutes > SAY_UNTIL_MAX_MIN:
        return []
    h, m = divmod(minutes, 60)
    if h and h not in DUR_HOUR:      # 상한을 환경변수로 올려도 조각이 없으면 말하지 않습니다
        return []
    out = []
    if h:
        out.append(f"d-{h}")
    if m:
        out.append(f"m-{m}")
    return out + ["g-after"]


def until_text(minutes: int) -> str:
    if not SAY_UNTIL:
        return ""
    if minutes < 1:
        return "잠시 후"
    if minutes > SAY_UNTIL_MAX_MIN:
        return ""
    h, m = divmod(minutes, 60)
    if h and h not in DUR_HOUR:
        return ""
    parts = ([f"{DUR_HOUR[h]} 시간"] if h else []) + ([f"{sino(m)} 분"] if m else [])
    return " ".join(parts) + " 후"


def parse_days(raw: str) -> list[int]:
    """0/8/9 는 단독일 때만 유효합니다.

    '01' 을 [월요일] 로 조용히 바꿔 버리면 사용자는 평일로 걸었다고 믿습니다.
    그래서 섞여 있으면 빈 목록(=오입력)으로 돌려줍니다.
    """
    raw = (raw or "").strip()
    if raw in ("0", "8", "9"):
        return {"0": [1, 2, 3, 4, 5], "8": [6, 7],
                "9": [1, 2, 3, 4, 5, 6, 7]}[raw]
    if not raw or any(c not in "1234567" for c in raw):
        return []
    return sorted(set(int(c) for c in raw))


def day_pieces(days: list[int]) -> list[str]:
    if days == [1, 2, 3, 4, 5]:
        return ["g-weekday"]
    if days == [6, 7]:
        return ["g-weekend"]
    if days == [1, 2, 3, 4, 5, 6, 7]:
        return ["g-everyday"]
    # 요일을 여러 개 이어 읽으면 "월요일수요일금요일" 로 붙습니다. 사이를 띄웁니다.
    out = []
    for d in days:
        out += [f"w-{d}", SIL]
    return out[:-1]


def day_text(days: list[int]) -> str:
    if days == [1, 2, 3, 4, 5]:
        return "평일"
    if days == [6, 7]:
        return "주말"
    if days == [1, 2, 3, 4, 5, 6, 7]:
        return "매일"
    return " ".join(DAY_TEXT[d] for d in days)


def day_short(days: list[int]) -> str:
    if days == [1, 2, 3, 4, 5]:
        return "평일"
    if days == [6, 7]:
        return "주말"
    if days == [1, 2, 3, 4, 5, 6, 7]:
        return "매일"
    return "".join(DAY_SHORT[d] for d in days)


def next_occurrence(days: list[int], hh: int, mm: int, now: datetime) -> datetime:
    for i in range(8):
        d = now + timedelta(days=i)
        if d.isoweekday() in days:
            t = d.replace(hour=hh, minute=mm, second=0, microsecond=0)
            if t > now + timedelta(seconds=30):
                return t
    return now


def playlist(names: list[str]) -> str:
    return "&".join(f"{BANK}/{n}" for n in names)


# ------------------------------------------------------------------ AGI 배관
class AGI:
    def __init__(self) -> None:
        self.env: dict[str, str] = {}
        while True:
            line = sys.stdin.readline().strip()
            if not line:
                break
            if ":" in line:
                k, _, v = line.partition(":")
                self.env[k.strip()] = v.strip()

    def cmd(self, text: str) -> str:
        sys.stdout.write(text + "\n")
        sys.stdout.flush()
        return sys.stdin.readline().strip()

    def set_var(self, name: str, value: str) -> None:
        self.cmd('SET VARIABLE %s "%s"' % (name, str(value).replace('"', "")))

    def verbose(self, msg: str) -> None:
        self.cmd('VERBOSE "%s" 1' % str(msg).replace('"', "'"))


def as_asterisk(p: Path) -> None:
    """asterisk 사용자가 쓸 수 있게. root 로 만든 파일을 그대로 두면
    AGI(=asterisk)가 다음부터 조용히 못 씁니다."""
    try:
        import pwd
        os.chown(p, pwd.getpwnam("asterisk").pw_uid, -1)
    except (KeyError, PermissionError, ImportError, FileNotFoundError):
        pass


def log(msg: str) -> None:
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        new = not LOG.exists()
        with LOG.open("a") as f:
            f.write(f"{datetime.now():%F %T} {msg}\n")
        if new:
            os.chmod(LOG, 0o664)
            as_asterisk(LOG)
    except OSError:
        pass


# ------------------------------------------------------------------ 규칙 저장
class rules_lock:
    """규칙 파일을 건드리는 모든 경로가 이 잠금을 씁니다.

    등록/삭제/전체취소/콘솔삭제가 겹치면 읽고-쓰기 사이에 남의 변경이
    끼어들어 규칙이 되살아나거나 사라집니다. 지운 알람이 다음 날 다시
    울리는 종류의 버그라 원인을 찾기가 아주 어렵습니다.
    """

    def __enter__(self):
        STATE.mkdir(parents=True, exist_ok=True)
        as_asterisk(STATE)
        self.p = STATE / ".lock"
        self.f = self.p.open("a+")
        try:
            os.chmod(self.p, 0o664)
        except OSError:
            pass
        as_asterisk(self.p)
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()
        return False


class RulesUnreadable(Exception):
    """파일이 깨졌거나 못 읽음. 없는 것(=빈 목록)과 반드시 구분해야 합니다.
    구분하지 않으면 저장할 때 남의 규칙까지 전부 날려 버립니다."""


def load_rules(strict: bool = False) -> list[dict]:
    if not RULES.exists():
        return []
    try:
        data = json.loads(RULES.read_text(encoding="utf-8"))
        rules = data.get("rules", [])
        if not isinstance(rules, list):
            raise ValueError("rules 가 목록이 아닙니다")
        return rules
    except (OSError, ValueError) as e:
        if strict:
            raise RulesUnreadable(str(e)) from e
        return []


def save_rules(rules: list[dict]) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    as_asterisk(STATE)
    if RULES.exists():                      # 하루 한 벌 백업
        try:
            bak = STATE / "rules.bak.json"
            if not bak.exists() or datetime.fromtimestamp(
                    bak.stat().st_mtime).date() != datetime.now().date():
                bak.write_bytes(RULES.read_bytes())
                as_asterisk(bak)
        except OSError:
            pass
    tmp = RULES.with_suffix(".tmp")
    tmp.write_text(json.dumps({"rules": rules}, ensure_ascii=False, indent=1),
                   encoding="utf-8")
    try:
        os.chmod(tmp, 0o664)
    except OSError:
        pass
    as_asterisk(tmp)
    tmp.replace(RULES)


# ------------------------------------------------------------------ 예약
def make_call_file(ext: str, target: datetime, tag: str = "once") -> Path:
    hh, mm = target.hour, target.minute
    pieces = time_pieces(hh, mm)
    STAGING.mkdir(parents=True, exist_ok=True)
    SPOOL.mkdir(parents=True, exist_ok=True)
    name = f"wakeup-{ext}-{hh:02d}{mm:02d}-{tag}-{os.getpid()}.call"
    tmp = STAGING / name
    tmp.write_text(
        f"; 알림전화 — {target:%Y-%m-%d %H:%M} / 내선 {ext} / {tag}\n"
        f"Channel: Local/{ext}@from-internal\n"
        f'CallerID: "시간 알림 서비스" <7000>\n'
        f"WaitTime: {RING_SEC}\nMaxRetries: {MAX_RETRY}\nRetryTime: {RETRY_SEC}\n"
        f"Context: {DEST_CTX}\nExtension: s\nPriority: 1\n"
        f"Setvar: WAKEUP_EXT={ext}\n"
        f"Setvar: WAKEUP_TIME={hh:02d}:{mm:02d}\n"
        f"Setvar: WAKEUP_EPOCH={int(target.timestamp())}\n"
        # "안녕하세요. 알림 써비스입니다. 현재 시각은 …입니다."
        f"Setvar: WK_SEQ={playlist(['sil-500', 'g-hello', 'g-intro', 'g-nowtime'] + pieces + ['g-isnida'])}\n"
        f"Setvar: WK_DISPLAY=시간 알림\n"
        f"Archive: yes\n", encoding="utf-8")
    os.utime(tmp, (target.timestamp(), target.timestamp()))
    as_asterisk(tmp)
    dest = SPOOL / name
    tmp.replace(dest)
    return dest


def make_callback_file(ext: str, attempt: int = 0) -> Path:
    """지금 이 내선으로 되거는 call file. CB_DELAY 초 뒤에 발사되도록
    mtime 을 미래로 잡습니다 (원래 7000 통화가 끊길 시간을 줍니다).
    답하면 Context=CB_MENU_CTX(메뉴)로 들어갑니다. 자동응답 헤더는
    Channel 이 거치는 CB_DIAL_CTX 에서 붙습니다."""
    STAGING.mkdir(parents=True, exist_ok=True)
    SPOOL.mkdir(parents=True, exist_ok=True)
    name = f"wakeup-cb-{ext}-{attempt}-{os.getpid()}.call"
    tmp = STAGING / name
    tmp.write_text(
        f"; 시간 알림 콜백 -> 내선 {ext} (attempt {attempt})\n"
        f"Channel: Local/{ext}@{CB_DIAL_CTX}/n\n"
        f'CallerID: "시간 알림 서비스" <7000>\n'
        # 즉시(0초) 걸므로 원 통화가 채 안 끊겨 잠깐 통화중일 수 있습니다.
        # 그 경우 3초 뒤 한 번 재시도합니다.
        f"MaxRetries: 1\nRetryTime: 3\nWaitTime: 30\n"
        f"Context: {CB_MENU_CTX}\nExtension: s\nPriority: 1\n"
        # 메뉴가 재콜백을 걸 수 있게 대상 내선과 시도 횟수를 넘겨 줍니다.
        f"Setvar: WK_CB_EXT={ext}\n"
        f"Setvar: WK_CB_ATTEMPT={attempt}\n"
        f"Archive: no\n", encoding="utf-8")
    # 첫 콜백은 즉시(CB_DELAY), 무입력 재콜백은 CB_RETRY_DELAY(1분) 뒤.
    delay = CB_DELAY if attempt == 0 else CB_RETRY_DELAY
    when = datetime.now().timestamp() + delay
    os.utime(tmp, (when, when))
    as_asterisk(tmp)
    dest = SPOOL / name
    tmp.replace(dest)
    return dest


def already_booked(ext: str, target: datetime) -> bool:
    for p in SPOOL.glob(f"wakeup-{ext}-{target:%H%M}-*.call"):
        try:
            if abs(datetime.fromtimestamp(p.stat().st_mtime)
                   - target).total_seconds() < 60:
                return True
        except OSError:
            pass
    return False


def collect(ext: str) -> list[dict]:
    """이 내선의 예약을 항상 같은 순서로 모읍니다.

    반복이 오늘치로 깔아 둔 call file 은 목록에서 숨깁니다 (같은 예약이
    두 번 보이면 헷갈립니다). 정렬 기준은 목표 시각이고, 시각이 같으면
    파일 이름으로 갈라 순서를 고정합니다. 재시도로 mtime 이 바뀌어도
    순서가 흔들리지 않게 이름에 박아 둔 HHMM 을 씁니다.
    """
    rules = [r for r in load_rules() if str(r.get("ext")) == ext]
    rep_tags = {f"-rep{r['id']}-" for r in rules}
    once = []
    for p in SPOOL.glob(f"wakeup-{ext}-*.call"):
        if any(t in p.name for t in rep_tags):
            continue
        try:
            hhmm = p.name.split("-")[2]
            at = datetime.fromtimestamp(p.stat().st_mtime)
        except (OSError, IndexError):
            continue
        once.append({"kind": "once", "path": p, "at": at,
                     "key": f"f:{p.name}", "sort": (hhmm, p.name)})
    once.sort(key=lambda x: x["sort"])
    reps = [{"kind": "rep", "rule": r, "key": f"r:{r['id']}"} for r in rules]
    return once + reps


def item_pieces(it: dict) -> list[str]:
    if it["kind"] == "once":
        t = it["at"]
        head = "g-today" if t.date() == datetime.now().date() else "g-tomorrow"
        return [head] + time_pieces(t.hour, t.minute, with_day=True)
    r = it["rule"]
    return day_pieces(r["days"]) + [SIL] + time_pieces(r["hh"], r["mm"], True)


def item_text(it: dict) -> str:
    if it["kind"] == "once":
        t = it["at"]
        head = "오늘" if t.date() == datetime.now().date() else "내일"
        return f"{head} {time_text(t.hour, t.minute, True)}"
    r = it["rule"]
    return f"{day_text(r['days'])} {time_text(r['hh'], r['mm'], True)}"


def item_short(it: dict) -> str:
    # 전화기 화면이 좁아 잘리므로 띄어쓰기 없이 붙입니다 (예 "평일07:00").
    # once 도 반복과 같은 형식(2글자 머리말 + HH:MM, 24시간)으로 맞춥니다.
    # 오늘/내일을 붙여 같은 시각의 오늘·내일 예약이 화면에서 구분됩니다.
    if it["kind"] == "once":
        t = it["at"]
        head = "오늘" if t.date() == datetime.now().date() else "내일"
        return f"{head}{t:%H:%M}"
    r = it["rule"]
    return f"{day_short(r['days'])}{r['hh']:02d}:{r['mm']:02d}"


def remove_key(ext: str, key: str) -> bool:
    """목록에서 announce 한 그 항목만 지웁니다.

    번호가 아니라 키로 지웁니다. 안내와 입력 사이에 알람 하나가 울려
    사라지면 번호가 밀려 엉뚱한 걸 지우기 때문입니다.
    """
    if key.startswith("f:"):
        p = SPOOL / key[2:]
        try:
            p.unlink()
            return True
        except OSError:
            return False
    if not key.startswith("r:"):
        return False
    rid = int(key[2:])
    with rules_lock():
        try:
            rules = load_rules(strict=True)
        except RulesUnreadable:
            return False                     # 못 읽으면 아무것도 지우지 않습니다
        keep = [r for r in rules if r.get("id") != rid]
        if len(keep) == len(rules):
            return False
        save_rules(keep)
    for p in SPOOL.glob(f"wakeup-{ext}-*-rep{rid}-*.call"):
        try:
            p.unlink()
        except OSError:
            pass
    return True


def booked_count(ext: str) -> int:
    """사용자에게 보이는 개수와 같아야 합니다. collect() 를 그대로 씁니다."""
    return len(collect(ext))


# --------------------------------------------------- 목록 스냅샷 (번호 밀림 방지)
def snap_path(token: str) -> Path:
    safe = "".join(c for c in (token or "x") if c.isalnum() or c in "._-")[:64]
    return STATE / f"list-{safe or 'x'}.json"


def snap_save(token: str, items: list[dict]) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    as_asterisk(STATE)
    p = snap_path(token)
    p.write_text(json.dumps([it["key"] for it in items]), encoding="utf-8")
    try:
        os.chmod(p, 0o664)
    except OSError:
        pass
    as_asterisk(p)
    # 오래된 스냅샷 청소
    cut = datetime.now().timestamp() - 3600
    for q in STATE.glob("list-*.json"):
        try:
            if q.stat().st_mtime < cut:
                q.unlink()
        except OSError:
            pass


def snap_load(token: str) -> list[str]:
    try:
        return json.loads(snap_path(token).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []


# ------------------------------------------------------------------ prune
def prune() -> int:
    """지난 call file 을 버립니다.

    서버가 꺼져 있다 켜지면 mtime 이 과거인 call file 을 Asterisk 가
    즉시 발사합니다. 아침 일곱시 알람이 저녁 아홉시에 울립니다.
    그래서 asterisk 가 뜨기 전에 한 번 쓸어 냅니다.
    """
    cut = datetime.now().timestamp() - STALE_SEC
    n = 0
    for p in SPOOL.glob("wakeup-*.call"):
        try:
            if p.stat().st_mtime < cut:
                p.unlink()
                n += 1
        except OSError:
            pass
    if n:
        log(f"PRUNE 지난 call file {n}개 삭제")
    return n


# ------------------------------------------------------------------ main
def main() -> int:
    agi = AGI()
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    a1 = sys.argv[2].strip() if len(sys.argv) > 2 else ""
    a2 = sys.argv[3].strip() if len(sys.argv) > 3 else ""
    ext = (sys.argv[4].strip() if len(sys.argv) > 4 else "") \
        or agi.env.get("agi_callerid", "").strip()

    agi.set_var("WK_OK", "0")
    agi.set_var("WK_ERR", "")

    def fail(kind: str, why: str) -> int:
        agi.set_var("WK_ERR", kind)
        agi.verbose(f"wakeup[{kind}]: {why}")
        log(f"FAIL ext={ext} mode={mode} a1={a1!r} a2={a2!r} {kind}: {why}")
        return 0

    if mode == "prune":
        agi.set_var("WK_COUNT", str(prune()))
        agi.set_var("WK_OK", "1")
        return 0

    if not ext.isdigit():
        return fail("input", f"내선을 알 수 없습니다: {ext!r}")

    if mode == "undo":
        # 0번을 눌러 고치겠다고 했을 때, 방금 만든 것만 되돌립니다.
        if a1 and remove_key(ext, a1):
            agi.set_var("WK_OK", "1")
            log(f"UNDO ext={ext} key={a1}")
        else:
            agi.set_var("WK_ERR", "io")
            log(f"UNDO-FAIL ext={ext} key={a1!r}")
        return 0

    if mode == "callback":
        # 7000 진입점(attempt 0) 또는 메뉴 무입력 재콜백(attempt 1) 요청.
        attempt = int(a1) if a1.isdigit() else 0
        try:
            p = make_callback_file(ext, attempt)
        except OSError as e:
            return fail("io", f"콜백 call file 실패: {e}")
        agi.set_var("WK_OK", "1")
        log(f"CALLBACK ext={ext} attempt={attempt} file={p.name}")
        return 0

    now = datetime.now()

    # ---------------- 목록 / 삭제
    # 목록은 한 건씩(item 모드) 들려주므로, list 모드는 스냅샷 저장과 개수만
    # 돌려주면 됩니다. (예전 '전부 읽어 주고 번호로 삭제' 흐름은 없어졌습니다)
    if mode in ("list", "del"):
        items = collect(ext)
        if mode == "list":
            shown = items[:9]
            snap_save(a2, shown)
            agi.set_var("WK_COUNT", str(len(shown)))
            agi.set_var("WK_OK", "1")
            return 0

        keys = snap_load(a2)
        if not a1.isdigit() or not (1 <= int(a1) <= len(keys)):
            return fail("input", f"목록에 없는 번호: {a1!r} (1~{len(keys)})")
        key = keys[int(a1) - 1]
        want = [it for it in items if it["key"] == key]
        if not want:
            return fail("input", "그 사이에 사라진 항목입니다")
        it = want[0]
        if not remove_key(ext, key):
            return fail("io", "삭제하지 못했습니다")
        # 다이얼플랜이 "${WK_DISPLAY} 삭제" 로 화면을 만드므로 여기선 '삭제'를
        # 붙이지 않습니다 (붙이면 "… 삭제 삭제" 로 두 번 나옵니다).
        agi.set_var("WK_DISPLAY", item_short(it))
        agi.set_var("WK_OK", "1")
        log(f"DEL ext={ext} no={a1} {item_text(it)} left={len(collect(ext))}")
        return 0

    # ---------------- 목록 한 건씩 (수정/삭제/다음)
    if mode == "item":
        # a1 = 1부터 시작하는 스냅샷 인덱스, a2 = 스냅샷 토큰
        keys = snap_load(a2)
        if not a1.isdigit() or not (1 <= int(a1) <= len(keys)):
            return fail("input", f"목록 범위 밖: {a1!r} (1~{len(keys)})")
        key = keys[int(a1) - 1]
        want = [it for it in collect(ext) if it["key"] == key]
        agi.set_var("WK_TOTAL", str(len(keys)))
        if not want:
            # 안내 사이에 알람이 울려 사라진 항목 -> 건너뛰라고 알림 (WK_OK=0)
            agi.set_var("WK_ERR", "gone")
            return 0
        it = want[0]
        agi.set_var("WK_ITEM", playlist(item_pieces(it)))
        agi.set_var("WK_DISPLAY", item_short(it))
        agi.set_var("WK_KIND", it["kind"])       # once | rep
        agi.set_var("WK_KEY", key)
        agi.set_var("WK_TEXT", item_text(it))
        agi.set_var("WK_OK", "1")
        return 0

    # ---------------- 시각 알림 / N분 뒤 알림
    if mode in ("peek-time", "book-time", "peek-after", "book-after"):
        if mode.endswith("time"):
            if len(a1) != 4 or not a1.isdigit():
                return fail("input", f"네 자리가 아닙니다: {a1!r}")
            hh, mm = int(a1[:2]), int(a1[2:])
            if hh > 23 or mm > 59:
                return fail("input", f"범위를 벗어났습니다: {hh}:{mm:02d}")
            target = now.replace(hour=hh, minute=mm, second=0, microsecond=0)
            if target <= now + timedelta(seconds=30):
                target += timedelta(days=1)
        else:
            if not a1.isdigit() or not (1 <= int(a1) <= 1439):
                return fail("input", f"분이 이상합니다: {a1!r} (1~1439)")
            # 초를 버리면 목표가 최대 59초 앞당겨집니다. 30초를 더해 반올림해서
            # 사용자가 누른 분 수와 실제 울리는 시각이 어긋나지 않게 합니다.
            target = (now + timedelta(minutes=int(a1), seconds=30)) \
                .replace(second=0, microsecond=0)
            hh, mm = target.hour, target.minute

        # 가득 찼으면 확인 전에 미리 알려 줍니다.
        # 확인까지 다 듣고 나서 실패하면 왜 안 되는지 알 길이 없습니다.
        if not already_booked(ext, target) and booked_count(ext) >= MAX_BOOK:
            return fail("full", f"예약이 가득 찼습니다 ({MAX_BOOK}개)")

        mins = int(round((target - now).total_seconds() / 60))
        today = target.date() == now.date()
        u = until_pieces(mins)
        with_day = not u
        head = [] if u else ["g-today" if today else "g-tomorrow"]
        head_t = "" if u else ("오늘 " if today else "내일 ")
        pieces = time_pieces(hh, mm, with_day=True)
        # 1번은 사용자가 누른 분 수를 그대로 되읽습니다.
        # 계산해서 되돌리면 초 버림 때문에 10 을 누르고 "구 분 뒤" 를 듣게 됩니다.
        said_min = int(a1) if mode.endswith("after") else mins
        rel = rel_pieces(said_min)
        # 화면은 반복과 같은 압축형(오늘/내일 + HH:MM, 24시간). 음성은 12시간(오후 한 시).
        agi.set_var("WK_DISPLAY",
                    f"{'오늘' if today else '내일'}{hh:02d}:{mm:02d}")
        # 1번(몇 분 후)은 상대시각으로, 2번(시각)은 날짜+시각으로 들려줍니다.
        # 방금 누른 것을 그대로 되읽어 주는 쪽이 확인이 빠릅니다.
        if mode.endswith("after"):
            said = rel
            agi.set_var("WK_TEXT", rel_text(said_min))
        else:
            said = ["g-today" if today else "g-tomorrow"] + pieces
            agi.set_var("WK_TEXT",
                        ("오늘 " if today else "내일 ") + time_text(hh, mm, True))

        if mode.startswith("peek"):
            agi.set_var("WK_OK", "1")
            return 0

        if already_booked(ext, target):
            agi.set_var("WK_CONFIRM", playlist(said + [SIL, "g-dup"]))
            agi.set_var("WK_ERR", "dup")
            # 반복(peek-rep)과 화면 문구를 맞춥니다 ("… 이미 있음")
            agi.set_var("WK_DISPLAY",
                        f"{'오늘' if today else '내일'}{hh:02d}:{mm:02d} 이미 있음")
            agi.set_var("WK_OK", "1")
            log(f"DUP ext={ext} at={target:%F %H:%M}")
            return 0
        try:
            path = make_call_file(ext, target)
        except OSError as e:
            return fail("io", f"{type(e).__name__}: {e}")

        # "…알람 설정하였습니다." — 조사가 없어 정오/정각 예외 처리가 필요 없습니다
        agi.set_var("WK_CONFIRM", playlist(said + ["t-set"]))
        agi.set_var("WK_KEY", "f:" + path.name)
        agi.set_var("WK_OK", "1")
        agi.verbose(f"예약 {target:%F %H:%M}")
        log(f"BOOK ext={ext} at={target:%F %H:%M} in={mins}분 file={path.name}")
        return 0

    # ---------------- 반복 알림
    if mode in ("peek-rep", "book-rep"):
        days = parse_days(a1)
        if not days:
            return fail("input", f"요일 입력이 이상합니다: {a1!r}")
        if len(a2) != 4 or not a2.isdigit():
            return fail("input", f"네 자리가 아닙니다: {a2!r}")
        hh, mm = int(a2[:2]), int(a2[2:])
        if hh > 23 or mm > 59:
            return fail("input", f"범위를 벗어났습니다: {hh}:{mm:02d}")

        dp, tp = day_pieces(days), time_pieces(hh, mm, with_day=True)
        # 화면은 좁아서 붙여 씁니다 (item_short 와 같은 "평일07:30" 형식).
        agi.set_var("WK_DISPLAY", f"{day_short(days)}{hh:02d}:{mm:02d}")
        agi.set_var("WK_TEXT", f"{day_text(days)} {time_text(hh, mm, True)}")

        dup = any(str(r.get("ext")) == ext and r.get("days") == days
                  and r.get("hh") == hh and r.get("mm") == mm
                  for r in load_rules())
        if mode == "peek-rep":
            if not dup and booked_count(ext) >= MAX_BOOK:
                return fail("full", f"예약이 가득 찼습니다 ({MAX_BOOK}개)")
            agi.set_var("WK_OK", "1")
            return 0

        if dup:
            agi.set_var("WK_CONFIRM", playlist(dp + [SIL] + tp + [SIL, "g-dup"]))
            agi.set_var("WK_ERR", "dup")
            agi.set_var("WK_DISPLAY", f"{day_short(days)}{hh:02d}:{mm:02d} 이미 있음")
            agi.set_var("WK_OK", "1")
            log(f"DUP-RULE ext={ext} days={days} {hh:02d}:{mm:02d}")
            return 0

        try:
            with rules_lock():
                rules = load_rules(strict=True)
                if any(str(r.get("ext")) == ext and r.get("days") == days
                       and r.get("hh") == hh and r.get("mm") == mm
                       for r in rules):
                    agi.set_var("WK_CONFIRM", playlist(dp + [SIL] + tp + [SIL, "g-dup"]))
                    agi.set_var("WK_ERR", "dup")
                    agi.set_var("WK_OK", "1")
                    return 0
                rid = max([r.get("id", 0) for r in rules], default=0) + 1
                rules.append({"id": rid, "ext": ext, "days": days,
                              "hh": hh, "mm": mm, "created": f"{now:%F %T}"})
                save_rules(rules)
        except (RulesUnreadable, OSError) as e:
            return fail("io", f"규칙 저장 실패: {e}")

        made_today = False
        if now.isoweekday() in days:
            t = now.replace(hour=hh, minute=mm, second=0, microsecond=0)
            if t > now + timedelta(seconds=30) and not already_booked(ext, t):
                try:
                    make_call_file(ext, t, tag=f"rep{rid}")
                    made_today = True
                except OSError:
                    pass

        nxt = next_occurrence(days, hh, mm, now)
        if nxt.date() == now.date():
            nd = ["g-today"]
        elif nxt.date() == (now + timedelta(days=1)).date():
            nd = ["g-tomorrow"]
        else:
            nd = [f"w-{nxt.isoweekday()}"]
        agi.set_var("WK_CONFIRM", playlist(
            dp + [SIL] + tp + ["t-set", SIL] + nd + ["g-fromnext"]))
        agi.set_var("WK_KEY", f"r:{rid}")
        agi.set_var("WK_OK", "1")
        agi.verbose(f"반복 #{rid} {day_text(days)} {time_text(hh, mm)}")
        log(f"RULE ext={ext} id={rid} days={days} at={hh:02d}:{mm:02d} "
            f"today={made_today} next={nxt:%F %H:%M}")
        return 0

    return fail("input", f"모드를 모르겠습니다: {mode!r}")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:                          # noqa: BLE001
        # AGI 가 죽으면 통화가 끊깁니다. 어떤 예외도 밖으로 내보내지 않습니다.
        log(f"CRASH {type(e).__name__}: {e}")
        sys.exit(0)
